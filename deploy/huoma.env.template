# ===== 火马平台环境变量模板 =====
# 复制此文件为 /etc/systemd/system/huoma.env 并填入真实值
# 切勿将真实凭据提交到 git！
#
# systemd 日志查看: journalctl -u bookstore-qrcode -f

# --- 数据库 ---
DB_HOST=rm-xxxx.mysql.rds.aliyuncs.com    # 阿里云 RDS 地址（替换为实际地址）
DB_USERNAME=bookstore
DB_PASSWORD=<your-password>

# --- Redis ---
REDIS_HOST=r-xxxx.redis.rds.aliyuncs.com  # 阿里云 Tair 地址（替换为实际地址）
REDIS_PASSWORD=<your-password>

# --- 企业微信 ---
WECOM_CORP_ID=wwxxxxxxxxxxxxxxxx
WECOM_CORP_SECRET=<your-secret>
WECOM_CALLBACK_TOKEN=<your-token>
WECOM_CALLBACK_AES_KEY=<your-aes-key>
WECOM_AGENT_ID=1000002                     # 自建应用 AgentId（应用消息推送，如转接对账）
WECOM_REPORT_AGENT_ID=1000014              # 删除日报专用自建应用 AgentId
WECOM_REPORT_CORP_SECRET=<your-secret>     # 删除日报专用自建应用 Secret

# --- 管理员 ---
ADMIN_DEFAULT_USERNAME=admin
ADMIN_DEFAULT_PASSWORD=<your-admin-password>

# --- 业务配置 ---
APP_BASE_URL=https://your-domain.com               # 应用根 URL（替换为实际域名，用于拼接表单链接等客户侧 URL）
TRANSFER_FORM_URL=https://your-domain.com/transfer-form
SCHOOL_ENTRY_URL=https://your-domain.com/s       # 学校查询页入口 URL（必填！替换为实际域名）
SCHOOL_RATE_LIMIT_MAX=500
UNDERTOW_WORKER_THREADS=40

# --- Agent 轮转 ---
AGENT_ROTATION_LOCK_TTL=60

# --- Redis Stream ---
CALLBACK_STREAM_MAXLEN=50000

# --- 客户删除员工日报 ---
# 推送时间在「系统配置」页动态设置（HH:mm），保存后即时生效，无需此处配置。
# 接收人兜底值（企微 userid，逗号分隔）。优先使用「系统配置」页的日报接收人设置，
# 只有系统配置留空时才回退到此环境变量。
DELETION_REPORT_ADMIN_USERIDS=zhangsan,lisi
